APP_NAME=DocMind-Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind
POSTGRES_DSN=postgresql://docmind:docmind@127.0.0.1:5432/docmind

REDIS_URL=redis://127.0.0.1:6379/0

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-0.6B

# M1b: FastEmbed/ONNX CPU. Snapshot comes from ModelScope, never Hugging Face.
# ModelScope: https://modelscope.cn/models/lyf219/bge-small-zh-v1.5-onnx
# The downloaded model and tokenizer are cached in a named Docker volume.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_VECTOR_SIZE=512
# M2b: ModelScope BGE reranker-base (~1.11GB ONNX, CPU only)
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_CANDIDATE_K=8
RAG_EVIDENCE_K=2
RAG_MAX_EVIDENCE_CHARS=160
RAG_MAX_ANSWER_TOKENS=128
MAX_UPLOAD_BYTES=10485760

# Optional: outbound HTTP(S) proxy used by the API container at runtime.
# On Windows with Clash HTTP/mixed port 7897:
# DOCMIND_PROXY_URL=http://host.docker.internal:7897
# No HF_ENDPOINT is required. Usually leave DOCMIND_PROXY_URL empty when
# ModelScope and its Chinese CDN are directly reachable.
